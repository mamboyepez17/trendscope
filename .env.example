# Reddit (opcional - TrendScope usa RSS gratis de old.reddit.com)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendScope/1.5.0

# Twitter/X - DevTools > Application > Cookies en x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# TweetClaw/OpenClaw optional JSON export path
TWEETCLAW_RESULTS_FILE=

# Claude API - para sentimiento premium (opcional)
ANTHROPIC_API_KEY=

# OpenRouter API - narrador inteligente con modelos gratuitos (opcional)
# Obtén tu key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Narrador: openrouter | deepseek | claude | ollama | none
NARRATOR_PROVIDER=openrouter
NARRATIVE_ENABLED=true

# DeepSeek (https://platform.deepseek.com) — compatible OpenAI
# Preferido: deepseek-v4.1-flash. Fallback: deepseek-flash, deepseek-v4-pro, deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Motor de sentimiento por defecto: local | claude
SENTIMENT_ENGINE=local

# Geo target (ISO 3166-1 alpha-2)
GEO_TARGET=CO

# Cantidad de resultados
TOP_N=25

# API REST
# En local: 127.0.0.1. En Docker: 0.0.0.0 (obligatorio API_KEY_REQUIRED=true si se expone)
API_HOST=127.0.0.1
API_PORT=8000
API_RATE_LIMIT=60
API_RATE_WINDOW=60
API_KEY_REQUIRED=false
# Formato legacy: "key1,key2"
# Formato con scopes: "key1|orgA|trends:read+watchlist:write,key2|orgB|trends:read"
API_KEYS=""
# Poner true solo detrás de reverse proxy de confianza (nginx, traefik)
TRUST_PROXY_HEADERS=false

# Ollama local
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Cache TTL en segundos
CACHE_TTL_SECONDS=300

# Watchlist
WATCHLIST_ENABLED=true
WATCHLIST_DEFAULT_INTERVAL_MINUTES=60

# Data directory
DATA_DIR=data

# OpenRouter metadata
OPENROUTER_SITE_URL=https://github.com/mamboyepez17/trendscope
OPENROUTER_SITE_NAME=TrendScope
