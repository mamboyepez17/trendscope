# Forma fácil: ejecuta `trendscope setup` y responde las preguntas.
# Reddit (opcional - TrendScope usa RSS gratis de old.reddit.com)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendScope/1.5.0
# Solo si Reddit da 403: cookie reddit_session del navegador (lo pide `trendscope setup`)
REDDIT_SESSION_COOKIE=

# Twitter/X - DevTools > Application > Cookies en x.com
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# TweetClaw/OpenClaw optional JSON export path
TWEETCLAW_RESULTS_FILE=

# Claude API - para sentimiento premium (opcional)
ANTHROPIC_API_KEY=

# OpenRouter API - narrador inteligente con modelos gratuitos (opcional)
# Obtén tu key gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── IA (una sola capa para narrador y motor de sentimiento "llm") ──
# Proveedor por defecto: openai | claude | deepseek | opencode | openrouter |
# gemini | groq | mistral | xai | qwen | glm | kimi | mimo | ollama | custom | none
# Vacío → usa NARRATOR_PROVIDER. Cada petición puede elegir otro con
# ?llm_provider=...&llm_model=...  (lista de modelos: GET /llm/models?provider=...)
LLM_PROVIDER=
# Narrador (compatibilidad): mismo valor que LLM_PROVIDER
NARRATOR_PROVIDER=openrouter
NARRATIVE_ENABLED=true

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude (Anthropic) — usa ANTHROPIC_API_KEY
CLAUDE_MODEL=claude-opus-5-5
# OpenCode Zen — https://opencode.ai/auth
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=
# xAI / Grok — https://console.x.ai
XAI_API_KEY=
XAI_MODEL=
# Qwen (Alibaba Model Studio) — https://www.alibabacloud.com/help/en/model-studio/get-api-key
# La key solo sirve en su región. EE. UU.: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# China: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
# GLM (Z.ai / Zhipu) — https://z.ai/manage-apikey/apikey-list
# Coding Plan: https://api.z.ai/api/coding/paas/v4 · China: https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=
# Kimi (Moonshot) — https://platform.moonshot.ai · China: https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
# Xiaomi MiMo — https://platform.xiaomimimo.com/console/api-keys
# Token Plan: usa la URL y la key tp-… de tu suscripción
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=
# Cualquier API compatible con OpenAI (LM Studio, vLLM, Together, Azure…)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DeepSeek (https://platform.deepseek.com) — compatible OpenAI
# Preferido: deepseek-v4.1-flash. Fallback: deepseek-flash, deepseek-v4-pro, deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Motor de sentimiento por defecto: local | claude | llm (la IA de LLM_PROVIDER)
SENTIMENT_ENGINE=local
# Modelo del motor "claude" (sentimiento + emociones)
CLAUDE_SENTIMENT_MODEL=claude-haiku-4-5

# Frescura: solo contenido de los últimos N días (1-30)
MAX_AGE_DAYS=7
# /trends también recolecta comentarios de la gente para el Índice de Ánimo
PIPELINE_COLLECT_COMMENTS=true

# Léxico propio (jerga local, marcas, sectores). Ejemplo: docs/lexicon.example.json
CUSTOM_LEXICON_PATH=

# X/Twitter con xactions-py al día (opcional): pip install -e ".[x]"
# reddit-actions (opcional, pip install -e ".[reddit]"): cookies si Reddit da 403
# REDDIT_SESSION_COOKIE=
# REDDIT_COOKIE_HEADER=

# Geo target (ISO 3166-1 alpha-2)
GEO_TARGET=CO

# Cantidad de resultados
TOP_N=25

# API REST
# En local: 127.0.0.1. En Docker: 0.0.0.0 (obligatorio API_KEY_REQUIRED=true si se expone)
API_HOST=127.0.0.1
API_PORT=8000
API_RATE_LIMIT=60
API_RATE_WINDOW=60
API_KEY_REQUIRED=false
# Formato legacy: "key1,key2"
# Formato con scopes: "key1|orgA|trends:read+watchlist:write,key2|orgB|trends:read"
API_KEYS=""
# Poner true solo detrás de reverse proxy de confianza (nginx, traefik)
TRUST_PROXY_HEADERS=false

# Ollama local (LLM_PROVIDER=ollama, sin API key)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Cache TTL en segundos
CACHE_TTL_SECONDS=300

# Watchlist
WATCHLIST_ENABLED=true
WATCHLIST_DEFAULT_INTERVAL_MINUTES=60

# Data directory
DATA_DIR=data

# OpenRouter metadata
OPENROUTER_SITE_URL=https://github.com/mamboyepez17/trendscope
OPENROUTER_SITE_NAME=TrendScope
